# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=nikelpower2026
NEO4J_URI=bolt://neo4j:7687
NEO4J_HEAP=2G
NEO4J_PAGECACHE=2G

# Yandex Cloud AI (см. backend/sample.py и backend/app/llm/yandex_client.py)
YANDEX_CLOUD_FOLDER=
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_MODEL=
YANDEX_EMBEDDING_MODEL=
YANDEX_CLOUD_BASE_URL=https://ai.api.cloud.yandex.net/v1

# Эмбеддинги: Yandex text-search-doc обычно 256 измерений
EMBEDDING_DIMENSIONS=256
EMBEDDING_SIMILARITY_THRESHOLD=0.82
DICTIONARY_CONTEXT_TOP_K=15

# Redis
REDIS_URL=redis://redis:6379/0

# Paths (inside containers)
DOCUMENTS_DIR=/data/documents
INGESTION_STATE_DIR=/data/ingestion

# Ingestion tuning
CHUNK_SIZE_CHARS=6000
CHUNK_OVERLAP_CHARS=400
INGESTION_BATCH_SIZE=10
