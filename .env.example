# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=nikelpower2026
NEO4J_URI=bolt://neo4j:7687
NEO4J_HEAP=2G
NEO4J_PAGECACHE=2G

# Yandex Cloud AI — без пробелов и кавычек: KEY=value
# API-ключ: сервисный аккаунт каталога с ролью ai.languageModels.user
YANDEX_CLOUD_FOLDER=
YANDEX_CLOUD_API_KEY=
YANDEX_CLOUD_MODEL=gpt://<folder_id>/yandexgpt/latest
YANDEX_EMBEDDING_MODEL=emb://<folder_id>/text-search-doc/latest
YANDEX_CLOUD_BASE_URL=https://ai.api.cloud.yandex.net/v1
# Эмбеддинги: Yandex text-search-doc обычно 256 измерений
EMBEDDING_DIMENSIONS=256
EMBEDDING_SIMILARITY_THRESHOLD=0.82
DICTIONARY_CONTEXT_TOP_K=15

# Лимит токенов (основное значение по умолчанию — backend/app/llm/token_budget.py)
TOKEN_LIMIT=10000

# Redis
REDIS_URL=redis://redis:6379/0

# Paths (inside containers)
DOCUMENTS_DIR=/data/documents
INGESTION_STATE_DIR=/data/ingestion

# Ingestion tuning — paragraph-aware chunking (см. План чанкования.md)
CHUNK_TARGET_TOKENS=850
CHUNK_MAX_TOKENS=1000
CHUNK_OVERLAP_PARAGRAPHS=1
INGESTION_BATCH_SIZE=10

# Graphiti (тестовый контейнер: docker compose --profile graphiti up -d graphiti)
GRAPHITI_GROUP_ID=nikelpower

# Парсинг: LibreOffice + Qwen-VL (см. Описание Архитектуры парсинга.md)
LIBREOFFICE_BINARY=libreoffice
LIBREOFFICE_TIMEOUT_SEC=180
CONVERTED_PDF_DIR=/data/ingestion/converted
YANDEX_VISION_MODEL=gpt://b1ghh2ufu3o0t33psog1/qwen3.6-35b-a3b/latest
ANALYZE_DOCUMENT_IMAGES=true
# Legacy (не используется paragraph chunker):
# CHUNK_SIZE_CHARS=6000
# CHUNK_OVERLAP_PERCENT=15
