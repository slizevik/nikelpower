# Полный образ worker: Graphiti, парсеры PDF/DOCX/PPTX, очередь Redis
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV PIP_DEFAULT_TIMEOUT=300
ENV PIP_RETRIES=5

COPY requirements.txt requirements-worker.txt ./
RUN pip install --no-cache-dir --retries 5 \
    -r requirements.txt \
    -r requirements-worker.txt

COPY . .

CMD ["python", "-m", "app.ingestion.worker"]
